# Shared Git settings. Machine-specific overrides belong in config.local below.
[user]
	name = Eduardo Farinati
	email = eduardo.farinati@ufrgs.br

[merge]
	tool = nvimdiff
	guitool = nvimdiff
	keepBackup = false
	keepTemporaries = false

[diff]
	tool = nvimdiff
	guitool = nvimdiff
	mnemonicPrefix = true
	rename = true

[color]
	ui = auto
	upstream = cyan

[grep]
	lineNumber = true

[log]
	abbrevCommit = true
	follow = true

[push]
	default = upstream
	followTags = true
	autoSetupRemote = true

[tag]
	sort = version:refname

[versionsort]
	suffix = -pre
	suffix = .pre
	suffix = -beta
	suffix = .beta
	suffix = -rc
	suffix = .rc

# Preserve the integrations previously generated by Home Manager.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[gpg]
	format = openpgp

[gpg "openpgp"]
	program = gpg

# Relative to the deployed config file, so overrides stay outside the checkout.
[include]
	path = config.local
